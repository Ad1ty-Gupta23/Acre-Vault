# --- Express auth API (app.js) ---
PORT=5001
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/
JWT_SECRET=change-me
JWT_EXPIRE=7d
# Comma-separated list of allowed frontend origins (also used by fraud.py and chat.py)
CLIENT_URL=http://localhost:5173

# --- Document verification service (fraud.py) ---
# Only needed if tesseract is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:5001/api
VITE_FRAUD_API_URL=http://localhost:5000
VITE_CHAT_API_URL=http://localhost:8000
VITE_CONTRACT_ADDRESS=0x66C5655A7A3a86BB514ECa467502FF5517692191
VITE_CHAIN_ID=17000
VITE_RPC_URL=https://ethereum-holesky-rpc.publicnode.com
# Leave empty for chains without an explorer (e.g. the PoA network)
VITE_EXPLORER_URL=https://holesky.etherscan.io
# Block number printed by blockchain/scripts/deploy.js; limits event (history) queries
VITE_DEPLOY_BLOCK=0

# --- IPFS document storage (Express API) ---
# Pinata JWT with pinFileToIPFS permission: https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
# Frontend gateway used to open documents
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
