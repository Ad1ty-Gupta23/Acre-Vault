PORT=5001
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/
MONGODB_DATABASE=landrecords
# At least 32 characters (HS256)
JWT_SECRET=change-me-to-a-random-string-of-32-plus-characters
JWT_EXPIRE=7d
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# --- IPFS document storage ---
# Pinata JWT with pinFileToIPFS permission: https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
